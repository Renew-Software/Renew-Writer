{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R-Writer",
  "version": "1.0.0",
  "identifier": "io.github.rwriter.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "R-Writer",
        "width": 1024,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Lightweight paginated word processor",
    "longDescription": "R-Writer is a clean, distraction-free, paginated document editor supporting .docx, .odt, and .txt files with live page layout.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
